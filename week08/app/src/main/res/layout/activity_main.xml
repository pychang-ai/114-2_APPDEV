<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="海洋生物小百科"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnShark"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="鯊魚"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnTurtle"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <Button
        android:id="@+id/btnTurtle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="海龜"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/btnShark"
        app:layout_constraintStart_toEndOf="@id/btnShark"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnDolphin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="海豚"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnShark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnOctopus" />

    <Button
        android:id="@+id/btnOctopus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="章魚"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/btnDolphin"
        app:layout_constraintStart_toEndOf="@id/btnDolphin"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="輸入關鍵字 (如: 鯊, 龜...)"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/btnDolphin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="搜尋"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/etSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>