package com.example.portreport;

import android.content.Intent;
import android.os.Bundle;
import android.widget.Button;
import android.widget.EditText;
import android.widget.RadioButton;
import android.widget.RadioGroup;
import android.widget.Toast;

import androidx.activity.ComponentActivity;

public class ReportActivity extends ComponentActivity {

    private EditText etShip;
    private EditText etPort;
    private RadioGroup rgDirection;
    private RadioButton rbInbound;
    private RadioButton rbOutbound;
    private Button btnSubmit;
    private Button btnCancel;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_report);

        etShip = findViewById(R.id.etShip);
        etPort = findViewById(R.id.etPort);
        rgDirection = findViewById(R.id.rgDirection);
        rbInbound = findViewById(R.id.rbInbound);
        rbOutbound = findViewById(R.id.rbOutbound);
        btnSubmit = findViewById(R.id.btnSubmit);
        btnCancel = findViewById(R.id.btnCancel);

        Intent intent = getIntent();

        String defaultPort = intent.getStringExtra(MainActivity.EXTRA_DEFAULT_PORT);
        String oldShip = intent.getStringExtra(MainActivity.EXTRA_SHIP);
        String oldPort = intent.getStringExtra(MainActivity.EXTRA_PORT);
        String oldDirection = intent.getStringExtra(MainActivity.EXTRA_DIRECTION);

        if (oldShip != null) {
            etShip.setText(oldShip);
        }

        if (oldPort != null) {
            etPort.setText(oldPort);
        } else if (defaultPort != null) {
            etPort.setText(defaultPort);
        }

        if ("出港".equals(oldDirection)) {
            rbOutbound.setChecked(true);
        } else {
            rbInbound.setChecked(true);
        }

        btnSubmit.setOnClickListener(v -> submitReport());

        btnCancel.setOnClickListener(v -> {
            setResult(RESULT_CANCELED);
            finish();
        });
    }

    private void submitReport() {
        String ship = etShip.getText().toString().trim();
        String port = etPort.getText().toString().trim();

        if (ship.isEmpty()) {
            Toast.makeText(this, "請輸入船名", Toast.LENGTH_SHORT).show();
            return;
        }

        if (port.isEmpty()) {
            Toast.makeText(this, "請輸入港口", Toast.LENGTH_SHORT).show();
            return;
        }

        String direction;

        int checkedId = rgDirection.getCheckedRadioButtonId();

        if (checkedId == R.id.rbOutbound) {
            direction = "出港";
        } else {
            direction = "入港";
        }

        String status = "通報成功";

        Intent result = new Intent();
        result.putExtra(MainActivity.EXTRA_SHIP, ship);
        result.putExtra(MainActivity.EXTRA_PORT, port);
        result.putExtra(MainActivity.EXTRA_DIRECTION, direction);
        result.putExtra(MainActivity.EXTRA_STATUS, status);

        setResult(RESULT_OK, result);
        finish();
    }
}


