package com.example.portreport;

import android.content.Intent;
import android.os.Bundle;
import android.widget.ArrayAdapter;
import android.widget.Button;
import android.widget.ListView;
import android.widget.TextView;
import android.widget.Toast;

import androidx.activity.ComponentActivity;
import androidx.activity.result.ActivityResultLauncher;
import androidx.activity.result.contract.ActivityResultContracts;

import java.util.ArrayList;

public class MainActivity extends ComponentActivity {

    public static final String EXTRA_SHIP = "ship";
    public static final String EXTRA_PORT = "port";
    public static final String EXTRA_DIRECTION = "direction";
    public static final String EXTRA_STATUS = "status";
    public static final String EXTRA_DEFAULT_PORT = "default_port";

    private TextView tvSummary;
    private TextView tvShip;
    private TextView tvPort;
    private TextView tvDirection;
    private TextView tvStatus;
    private Button btnNewReport;
    private Button btnClearLatest;
    private ListView listViewReports;

    private ActivityResultLauncher<Intent> reportLauncher;

    private final ArrayList<Report> reportList = new ArrayList<>();
    private final ArrayList<String> reportTextList = new ArrayList<>();
    private ArrayAdapter<String> adapter;

    private String defaultPort = "高雄港";
    private int editingIndex = -1;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        tvSummary = findViewById(R.id.tvSummary);
        tvShip = findViewById(R.id.tvShip);
        tvPort = findViewById(R.id.tvPort);
        tvDirection = findViewById(R.id.tvDirection);
        tvStatus = findViewById(R.id.tvStatus);
        btnNewReport = findViewById(R.id.btnNewReport);
        btnClearLatest = findViewById(R.id.btnClearLatest);
        listViewReports = findViewById(R.id.listViewReports);

        adapter = new ArrayAdapter<>(
                this,
                android.R.layout.simple_list_item_1,
                reportTextList
        );

        listViewReports.setAdapter(adapter);

        reportLauncher = registerForActivityResult(
                new ActivityResultContracts.StartActivityForResult(),
                result -> {
                    if (result.getResultCode() == RESULT_OK && result.getData() != null) {
                        Intent data = result.getData();

                        String ship = data.getStringExtra(EXTRA_SHIP);
                        String port = data.getStringExtra(EXTRA_PORT);
                        String direction = data.getStringExtra(EXTRA_DIRECTION);
                        String status = data.getStringExtra(EXTRA_STATUS);

                        if (ship == null) ship = "";
                        if (port == null) port = "";
                        if (direction == null) direction = "";
                        if (status == null) status = "通報成功";

                        Report report = new Report(ship, port, direction, status);

                        if (editingIndex >= 0 && editingIndex < reportList.size()) {
                            reportList.set(editingIndex, report);
                            Toast.makeText(this, "通報已修改", Toast.LENGTH_SHORT).show();
                        } else {
                            reportList.add(report);
                            Toast.makeText(this, "通報成功", Toast.LENGTH_SHORT).show();
                        }

                        defaultPort = port;
                        updateLatestReport(report);
                        refreshHistoryList();

                    } else if (result.getResultCode() == RESULT_CANCELED) {
                        Toast.makeText(this, "通報已取消", Toast.LENGTH_SHORT).show();
                    }

                    editingIndex = -1;
                }
        );

        btnNewReport.setOnClickListener(v -> {
            editingIndex = -1;

            Intent intent = new Intent(MainActivity.this, ReportActivity.class);
            intent.putExtra(EXTRA_DEFAULT_PORT, defaultPort);

            reportLauncher.launch(intent);
        });

        btnClearLatest.setOnClickListener(v -> {
            clearLatestReport();
            Toast.makeText(this, "已清除", Toast.LENGTH_SHORT).show();
        });

        listViewReports.setOnItemClickListener((parent, view, position, id) -> {
            if (position < 0 || position >= reportList.size()) {
                return;
            }

            editingIndex = position;
            Report selectedReport = reportList.get(position);

            Intent intent = new Intent(MainActivity.this, ReportActivity.class);
            intent.putExtra(EXTRA_SHIP, selectedReport.ship);
            intent.putExtra(EXTRA_PORT, selectedReport.port);
            intent.putExtra(EXTRA_DIRECTION, selectedReport.direction);
            intent.putExtra(EXTRA_DEFAULT_PORT, selectedReport.port);

            reportLauncher.launch(intent);
        });

        clearLatestReport();
    }

    private void updateLatestReport(Report report) {
        tvSummary.setText(report.ship + " " + report.direction + " " + report.status);
        tvShip.setText("船名：" + report.ship);
        tvPort.setText("港口：" + report.port);
        tvDirection.setText("動態：" + report.direction);
        tvStatus.setText("狀態：" + report.status);
    }

    private void clearLatestReport() {
        tvSummary.setText("（尚無通報）");
        tvShip.setText("船名：（尚無通報）");
        tvPort.setText("港口：（尚無通報）");
        tvDirection.setText("動態：（尚無通報）");
        tvStatus.setText("狀態：（尚無通報）");
    }

    private void refreshHistoryList() {
        reportTextList.clear();

        for (Report report : reportList) {
            String text = "[" + report.direction + "] " + report.ship + " @ " + report.port;
            reportTextList.add(text);
        }

        adapter.notifyDataSetChanged();
    }

    private static class Report {
        String ship;
        String port;
        String direction;
        String status;

        Report(String ship, String port, String direction, String status) {
            this.ship = ship;
            this.port = port;
            this.direction = direction;
            this.status = status;
        }
    }
}


